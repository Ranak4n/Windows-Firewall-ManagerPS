<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Nouveau blocage"
    Height="680" Width="840" MinHeight="540" MinWidth="660"
    WindowStartupLocation="CenterOwner"
    FontFamily="Segoe UI" FontSize="13"
    Background="#FFF6F7F9">

    <Window.Resources>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#FF2D5BE3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF2449BC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#FFB9C2D6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF1F2430"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#FFD5DAE3" BorderThickness="1" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFEFF2F7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FFA6AEBE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            WPF ne permet pas de sélectionner le texte d'un TextBlock : la
            propriété IsTextSelectionEnabled appartient à WinUI, pas à WPF.
            Tous les textes fixes sont donc des TextBox en lecture seule et
            sans bordure, au rendu identique mais sélectionnables.
        -->
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Cursor" Value="IBeam"/>
        </Style>

        <!-- Variante alignée à gauche, pour ne pas capter le curseur sur
             toute la largeur de la ligne. -->
        <Style x:Key="SelectableLabel" TargetType="TextBox" BasedOn="{StaticResource SelectableText}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBox" BasedOn="{StaticResource SelectableLabel}">
            <Setter Property="Foreground" Value="#FF3C4658"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBox" BasedOn="{StaticResource SelectableText}">
            <Setter Property="Foreground" Value="#FF8A93A6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Étape 1 : dossier -->
        <StackPanel Grid.Row="0">
            <TextBox Text="1. Dossier du logiciel" Style="{StaticResource FieldLabel}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtFolder" Grid.Column="0" Padding="8,7"
                         BorderBrush="#FFD5DAE3" VerticalContentAlignment="Center"/>
                <Button x:Name="BtnBrowse" Grid.Column="1" Content="Parcourir..."
                        Style="{StaticResource QuietButton}" Margin="8,0,0,0"/>
            </Grid>
            <TextBox Text="Tous les exécutables du dossier et de ses sous-dossiers seront proposés."
                     Style="{StaticResource HintText}" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Étape 2 : nom -->
        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBox Text="2. Nom de l'ensemble" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtSetName" Padding="8,7" BorderBrush="#FFD5DAE3"
                     VerticalContentAlignment="Center"/>
            <TextBox x:Name="TxtGroupPreview" Style="{StaticResource HintText}" Margin="0,5,0,0"
                     Text="Groupe pare-feu : *FWM - ..."/>
        </StackPanel>

        <!-- Étape 3 : sens -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBox Text="3. Trafic à bloquer" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="CmbDirection" Padding="8,6" BorderBrush="#FFD5DAE3" SelectedIndex="0">
                <ComboBoxItem Content="Entrant et sortant (blocage complet)"/>
                <ComboBoxItem Content="Sortant uniquement"/>
                <ComboBoxItem Content="Entrant uniquement"/>
            </ComboBox>
        </StackPanel>

        <!-- Étape 4 : sélection -->
        <Grid Grid.Row="3" Margin="0,16,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="4. Exécutables à bloquer" Style="{StaticResource FieldLabel}"
                     VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnCheckAll" Content="Tout cocher" Style="{StaticResource QuietButton}"/>
                <Button x:Name="BtnUncheckAll" Content="Tout décocher" Style="{StaticResource QuietButton}" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>

        <ListView x:Name="LstExes" Grid.Row="4"
                  SelectionMode="Extended"
                  MinHeight="130"
                  BorderBrush="#FFD5DAE3" BorderThickness="1" Background="White"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="42">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Exécutable" Width="230" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Taille" Width="90" DisplayMemberBinding="{Binding SizeText}"/>
                    <GridViewColumn Header="Emplacement relatif" Width="380" DisplayMemberBinding="{Binding RelativePath}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBox x:Name="TxtSummary" Grid.Row="5" Margin="0,10,0,0"
                 Style="{StaticResource SelectableText}"
                 Foreground="#FF3C4658"
                 Text="Choisissez un dossier pour commencer."/>

        <!-- Journal de création, replié par défaut -->
        <Expander x:Name="ExpLog" Grid.Row="6" Margin="0,10,0,0"
                  Header="Journal des opérations" Foreground="#FF3C4658" IsExpanded="False">
            <Border BorderBrush="#FFD5DAE3" BorderThickness="1" Background="#FF1B2138" Margin="0,6,0,0">
                <TextBox x:Name="TxtLog"
                         Height="150"
                         IsReadOnly="True" AcceptsReturn="True"
                         BorderThickness="0" Background="Transparent"
                         Foreground="#FFD3DAEA"
                         FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12"
                         Padding="8"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
            </Border>
        </Expander>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnCancel" Content="Annuler" Style="{StaticResource QuietButton}"/>
            <Button x:Name="BtnCreate" Content="Créer les règles" Style="{StaticResource AccentButton}"
                    Margin="10,0,0,0" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
