<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Windows Firewall Manager"
    Height="600" Width="980" MinHeight="440" MinWidth="760"
    WindowStartupLocation="CenterScreen"
    FontFamily="Segoe UI" FontSize="13"
    Background="#FFF6F7F9">

    <!--
        Ni classe associée ni attributs d'événement : XamlReader ne sait pas
        charger de code-behind. Les gestionnaires sont câblés côté PowerShell
        via Add_Click sur les éléments retrouvés par FindName.
    -->

    <Window.Resources>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#FF2D5BE3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF2449BC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#FFB9C2D6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF1F2430"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#FFD5DAE3" BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFEFF2F7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FFA6AEBE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            WPF ne permet pas de sélectionner le texte d'un TextBlock : la
            propriété IsTextSelectionEnabled appartient à WinUI, pas à WPF.
            Une TextBox en lecture seule et sans bordure donne le même rendu
            tout en autorisant la sélection et Ctrl+C.
        -->
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Cursor" Value="IBeam"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0" Background="#FF1B2138" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Windows Firewall Manager"
                           Foreground="White" FontSize="19" FontWeight="SemiBold"/>
                <TextBox Style="{StaticResource SelectableText}"
                         Text="Bloquer l'accès réseau d'un logiciel, entrant et sortant, en quelques clics."
                         Foreground="#FF9FA9C4" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Bannière d'élévation, masquée si la session est déjà administrateur -->
        <Border x:Name="BorderElevation" Grid.Row="1"
                Background="#FFFDF3D6" BorderBrush="#FFE8CE7A" BorderThickness="0,0,0,1"
                Padding="20,10" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtElevation" Grid.Column="0" VerticalAlignment="Center"
                         Style="{StaticResource SelectableText}"
                         Foreground="#FF6B531A"
                         Text="Session non élevée : la consultation reste possible, mais la création et la suppression de règles exigent les droits administrateur."/>
                <Button x:Name="BtnElevate" Grid.Column="1" Content="Relancer en administrateur"
                        Style="{StaticResource QuietButton}" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- Barre d'actions -->
        <Border Grid.Row="2" Background="White" BorderBrush="#FFE1E4EA" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnNew" Content="Nouveau blocage" Style="{StaticResource AccentButton}"/>
                    <Button x:Name="BtnRemove" Content="Supprimer la sélection" Style="{StaticResource QuietButton}" Margin="10,0,0,0"/>
                    <Button x:Name="BtnRefresh" Content="Actualiser" Style="{StaticResource QuietButton}" Margin="10,0,0,0"/>
                </StackPanel>
                <Button x:Name="BtnOpenFirewall" Grid.Column="1"
                        Content="Ouvrir le Pare-feu Windows"
                        Style="{StaticResource QuietButton}"/>
            </Grid>
        </Border>

        <!-- Liste des ensembles -->
        <Grid Grid.Row="3" Margin="20,16,20,12">
            <ListView x:Name="LstSets"
                      SelectionMode="Extended"
                      BorderBrush="#FFE1E4EA" BorderThickness="1"
                      Background="White"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Ensemble" Width="180" DisplayMemberBinding="{Binding SetName}"/>
                        <GridViewColumn Header="Règles" Width="70" DisplayMemberBinding="{Binding RuleCount}"/>
                        <GridViewColumn Header="Entrant" Width="70" DisplayMemberBinding="{Binding Inbound}"/>
                        <GridViewColumn Header="Sortant" Width="70" DisplayMemberBinding="{Binding Outbound}"/>
                        <GridViewColumn Header="État" Width="80" DisplayMemberBinding="{Binding StateText}"/>
                        <GridViewColumn Header="Dossier d'origine" Width="400" DisplayMemberBinding="{Binding Root}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Message affiché quand aucun ensemble n'existe encore -->
            <TextBlock x:Name="TxtEmpty"
                       Text="Aucun blocage enregistré. Cliquez sur Nouveau blocage pour commencer."
                       Foreground="#FF8A93A6" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>

        <!-- Barre d'état -->
        <Border Grid.Row="4" Background="White" BorderBrush="#FFE1E4EA" BorderThickness="0,1,0,0" Padding="20,9">
            <TextBox x:Name="TxtStatus" Style="{StaticResource SelectableText}"
                     Foreground="#FF5A6478" Text="Prêt."/>
        </Border>
    </Grid>
</Window>
